# Copy to infra/.env.production, fill every required value, and keep it out of git.
# Use a unique random value for each deployment; do not reuse development secrets.
APP_URL=https://app.example.org
WEB_PORT=3000
POSTGRES_PASSWORD=replace-with-a-long-random-password
SECRET_KEY=replace-with-at-least-32-random-characters
MAX_UPLOAD_MB=2048
ALLOW_DEMO_LOGIN=false
AUTO_SEED=false

# Optional S3-compatible object storage. Leave STORAGE_BACKEND=local for the
# Docker volume; set STORAGE_BACKEND=s3 only after credentials and bucket policy
# are configured.
STORAGE_BACKEND=local
S3_BUCKET=
S3_REGION=eu-central-1
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PRESIGN_SECONDS=900

# Optional queue retry policy.
RUN_MAX_ATTEMPTS=3
RETRY_BASE_SECONDS=30

# Shared IP throttling needs a separately managed Redis service. Keep memory
# mode until REDIS_URL points at a reachable, private Redis instance.
RATE_LIMIT_BACKEND=memory
REDIS_URL=redis://localhost:6379/0

# Optional transactional mail.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=hello@example.org

# Optional Stripe subscriptions. Configure both price IDs and webhook signing
# secret in Stripe before setting STRIPE_SECRET_KEY.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_LAB=
STRIPE_PRICE_INSTITUTION=
