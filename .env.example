# ── Topiome local environment ────────────────────────────────────────────────
# Copy to .env for local development. Never commit real secrets.

APP_ENV=development
APP_NAME=Topiome
APP_URL=http://localhost:3000
API_URL=http://localhost:8000

# Auth
SECRET_KEY=change-me-to-a-long-random-string-at-least-32-chars
SESSION_COOKIE_NAME=topiome_session
ACCESS_TOKEN_TTL_MINUTES=10080

# Database (SQLite by default for local dev; Postgres for production)
DATABASE_URL=sqlite:///./topiome.db
# DATABASE_URL=postgresql+psycopg://topiome:topiome@localhost:5432/topiome

# Storage (local by default; s3 for production)
STORAGE_BACKEND=local
STORAGE_DIR=./storage
# S3_BUCKET=topiome-prod
# S3_REGION=eu-central-1
# S3_ENDPOINT_URL=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# Run queue: inline (dev, runs inside the API process) or worker (prod:
# start one or more `python -m app.worker` processes next to the API).
QUEUE_MODE=inline
RUN_TIMEOUT_HOURS=6
# Reserved for a future Redis/RQ backend; the current queue is Postgres-backed.
# REDIS_URL=redis://localhost:6379/0

# Sign-in throttling (per IP + email, per API process)
LOGIN_ATTEMPTS_PER_WINDOW=10
LOGIN_WINDOW_MINUTES=15

# Billing (optional until Stripe is configured)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_BASIC=
STRIPE_PRICE_STANDARD=

# Email (optional in dev; logs to console)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=hello@topiome.com

# Feature flags
ALLOW_DEMO_LOGIN=true
MAX_UPLOAD_MB=2048
