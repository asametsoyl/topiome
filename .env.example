# ── Topiome local environment ────────────────────────────────────────────────
# Copy to .env for local development. Never commit real secrets.

APP_ENV=development
APP_NAME=Topiome
APP_URL=http://localhost:3000
API_URL=http://localhost:8000

# Auth
SECRET_KEY=change-me-to-a-long-random-string-at-least-32-chars
SESSION_COOKIE_NAME=topiome_session
ACCESS_TOKEN_TTL_MINUTES=10080

# Database (SQLite by default for local dev; Postgres for production)
DATABASE_URL=sqlite:///./topiome.db
# DATABASE_URL=postgresql+psycopg://topiome:topiome@localhost:5432/topiome

# Storage (local by default; s3 for production)
STORAGE_BACKEND=local
STORAGE_DIR=./storage
# S3_BUCKET=topiome-prod
# S3_REGION=eu-central-1
# S3_ENDPOINT_URL=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_PRESIGN_SECONDS=900

# Run queue: inline (dev, runs inside the API process) or worker (prod:
# start one or more `python -m app.worker` processes next to the API).
QUEUE_MODE=inline
RUN_TIMEOUT_HOURS=6
# Optional shared rate-limit counters; the run queue remains Postgres-backed.
RATE_LIMIT_BACKEND=memory
REDIS_URL=redis://localhost:6379/0
RUN_MAX_ATTEMPTS=3
RETRY_BASE_SECONDS=30

# Sign-in throttling (per IP + email, per API process)
LOGIN_ATTEMPTS_PER_WINDOW=10
LOGIN_WINDOW_MINUTES=15
REGISTER_ATTEMPTS_PER_HOUR=5
UPLOAD_ATTEMPTS_PER_HOUR=20

# Invitations and MFA
INVITATION_TTL_HOURS=72
MFA_ISSUER=Topiome
BREACH_CHECK_ENABLED=true

# Billing (optional until Stripe is configured)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_LAB=
STRIPE_PRICE_INSTITUTION=

# Email (optional in dev; logs to console)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=hello@topiome.com

METRICS_TOKEN=

# Feature flags
ALLOW_DEMO_LOGIN=true
MAX_UPLOAD_MB=2048
