{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Topiome Disease Pack",
  "type": "object",
  "required": [
    "id",
    "version",
    "status",
    "name",
    "tissue",
    "data_richness",
    "cell_types",
    "zones",
    "targets",
    "report",
    "validation"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "status": {
      "enum": [
        "draft",
        "beta",
        "validated",
        "deprecated"
      ]
    },
    "name": {
      "type": "string",
      "minLength": 2
    },
    "short_name": {
      "type": "string"
    },
    "tissue": {
      "type": "string"
    },
    "data_richness": {
      "enum": [
        "high",
        "medium",
        "low"
      ]
    },
    "color": {
      "type": "string",
      "pattern": "^#[0-9A-Fa-f]{6}$"
    },
    "description": {
      "type": "string"
    },
    "aliases": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "reference": {
      "type": "object",
      "properties": {
        "scrna_sources": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "spatial_sources": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "minimum_samples": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "cell_types": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "markers",
          "color"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "name": {
            "type": "string"
          },
          "markers": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "color": {
            "type": "string",
            "pattern": "^#[0-9A-Fa-f]{6}$"
          }
        }
      }
    },
    "zones": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "markers",
          "color"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "name": {
            "type": "string"
          },
          "markers": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "color": {
            "type": "string",
            "pattern": "^#[0-9A-Fa-f]{6}$"
          },
          "description": {
            "type": "string"
          }
        }
      }
    },
    "targets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "gene",
          "name",
          "evidence_level"
        ],
        "properties": {
          "gene": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "rationale": {
            "type": "string"
          },
          "evidence_level": {
            "enum": [
              "established",
              "emerging",
              "exploratory"
            ]
          }
        }
      }
    },
    "report": {
      "type": "object",
      "required": [
        "title",
        "sections"
      ],
      "properties": {
        "title": {
          "type": "string"
        },
        "sections": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "validation": {
      "type": "object",
      "required": [
        "metrics",
        "last_run",
        "approved_by"
      ],
      "properties": {
        "metrics": {
          "type": "object"
        },
        "last_run": {
          "type": [
            "string",
            "null"
          ]
        },
        "approved_by": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "ligand_receptor_pairs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "ligand",
          "receptor",
          "sender",
          "receiver"
        ],
        "properties": {
          "ligand": {
            "type": "string"
          },
          "receptor": {
            "type": "string"
          },
          "sender": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "receiver": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "name": {
            "type": "string"
          },
          "category": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "not_assessed": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 3
      }
    },
    "atlas_reference": {
      "type": "object",
      "required": [
        "name",
        "citation",
        "file",
        "zone_map",
        "license_status"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "citation": {
          "type": "string"
        },
        "url": {
          "type": "string"
        },
        "file": {
          "type": "string",
          "pattern": "^references/[A-Za-z0-9_.-]+\\.json$"
        },
        "license_status": {
          "enum": [
            "cleared",
            "review_pending",
            "restricted"
          ]
        },
        "zone_map": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    }
  }
}
